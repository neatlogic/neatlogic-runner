<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.neatlogic</groupId>
    <artifactId>neatlogic-runner</artifactId>
    <version>0.4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>neatlogic-runner-framework</module>
        <module>neatlogic-runner-springboot</module>
        <module>neatlogic-runner-webroot</module>
    </modules>

    <properties>
        <java-version>17</java-version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tomcat.version>10.1.55</tomcat.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <jackson.version>2.15.0</jackson.version>
        <!-- 保留 MongoDB 4.0 协议兼容性；与 Spring Data 4.5.x 的组合需通过运行时回归验证。 -->
        <mongodb.version>5.4.0</mongodb.version>
    </properties>

    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshot</id>
            <url>http://192.168.0.88:9008/nexus/content/repositories/neatlogic-snapshot</url>
        </snapshotRepository>
        <repository>
            <id>nexus-release</id>
            <url>http://192.168.0.88:9008/nexus/content/repositories/neatlogic-release</url>
        </repository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>commercial</id>
            <modules>
                <module>../neatlogic-runner-codehub</module>
                <module>../neatlogic-runner-resourcespool</module>
            </modules>
        </profile>
    </profiles>
</project>
